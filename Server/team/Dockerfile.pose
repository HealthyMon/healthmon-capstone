FROM python:3.12-slim-bookworm
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1 HF_HUB_OFFLINE=1 TRANSFORMERS_OFFLINE=1 HEALTHMON_POSE_BIND=0.0.0.0
RUN apt-get update && apt-get install -y --no-install-recommends libgl1 libglib2.0-0 libgomp1 \
    && rm -rf /var/lib/apt/lists/*
COPY Server/team/requirements.txt /tmp/control.txt
RUN pip install --no-cache-dir -r /tmp/control.txt PyYAML==6.0.3 \
    numpy==2.2.6 onnxruntime==1.32.0 opencv-python==4.11.0.86 opencv-contrib-python==4.11.0.86 rtmlib==0.0.16
WORKDIR /app
COPY Ai/Pose/ Ai/Pose/
RUN python -c "from Ai.Pose.unity_service import create_app; create_app()"
CMD ["python", "-B", "-m", "Ai.Pose.unity_service"]
