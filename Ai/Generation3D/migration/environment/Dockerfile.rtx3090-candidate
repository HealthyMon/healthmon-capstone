# Build on the RTX 3090 x86_64 host. Resolve and record the target image digest before use.
ARG BASE_IMAGE=nvcr.io/nvidia/pytorch:25.11-py3
FROM --platform=linux/amd64 ${BASE_IMAGE}
USER root
RUN apt-get update && DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends \
    git build-essential cmake ninja-build python3-venv python3-dev blender \
    libgl1 libglib2.0-0 libegl1 libxrender1 libxi6 libxkbcommon0 && \
    rm -rf /var/lib/apt/lists/*
ENV TORCH_CUDA_ARCH_LIST=8.6 MAX_JOBS=4 PYTHONDONTWRITEBYTECODE=1
WORKDIR /opt/healthmon/Ai/Generation3D
COPY . /opt/healthmon/Ai/Generation3D
# Do not automatically install inherited ARM64 freezes or download/load models.
# Verify Blender 4.0.2 + embedded Python 3.12 compatibility and follow RTX3090_GUIDE.md.
CMD ["bash"]
