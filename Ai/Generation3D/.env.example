# Docker Compose: run `export HEALTHMON_UID=$(id -u) HEALTHMON_GID=$(id -g)` on your PC.
# No secrets or Hugging Face token are required for the copied, verified weights.
HEALTHMON_IMAGE=healthmon-3d:3090
HEALTHMON_QWEN_MEMORY_MODE=cuda
# To opt into the ORIGINAL runner's CPU offload option, change the value to:
# HEALTHMON_QWEN_MEMORY_MODE=model-cpu-offload
# BF16 model files are unchanged; RTX 3090 memory use has not been measured.
MAX_JOBS=4
