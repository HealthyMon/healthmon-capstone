  "components": {
    "schemas": {
      "ActivityInput": {
        "properties": {
          "event_id": {
            "type": "string",
            "maxLength": 100,
            "minLength": 1,
            "title": "Event Id"
          },
          "revision": {
            "type": "integer",
            "minimum": 1.0,
            "title": "Revision"
          },
          "occurred_at": {
            "type": "string",
            "format": "date-time",
            "title": "Occurred At"
          },
          "kind": {
            "type": "string",
            "enum": [
              "walk",
              "food"
            ],
            "title": "Kind"
          },
          "amount": {
            "type": "number",
            "maximum": 200000.0,
            "minimum": 0.0,
            "title": "Amount"
          },
          "unit": {
            "type": "string",
            "enum": [
              "steps",
              "serving"
            ],
            "title": "Unit"
          },
          "source": {
            "type": "string",
            "enum": [
              "user",
              "sensor",
              "backend",
              "photo"
            ],
            "title": "Source"
          },
          "confirmed": {
            "type": "boolean",
            "title": "Confirmed",
            "default": false
          },
          "label": {
            "type": "string",
            "maxLength": 100,
            "title": "Label",
            "default": ""
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "event_id",
          "revision",
          "occurred_at",
          "kind",
          "amount",
          "unit",
          "source"
        ],
        "title": "ActivityInput"
      },
      "ChatInput": {
        "properties": {
          "request_id": {
            "type": "string",
            "maxLength": 100,
            "minLength": 8,
            "title": "Request Id"
          },
          "text": {
            "type": "string",
            "maxLength": 1500,
            "minLength": 1,
            "title": "Text"
          },
          "state_version": {
            "anyOf": [
              {
                "type": "integer",
                "minimum": 0.0
              },
              {
                "type": "null"
              }
            ],
            "title": "State Version"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "request_id",
          "text"
        ],
        "title": "ChatInput"
      },
      "Decision": {
        "properties": {
          "decision": {
            "type": "string",
            "enum": [
              "accept",
              "reject"
            ],
            "title": "Decision"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "decision"
        ],
        "title": "Decision"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "MemoryInput": {
        "properties": {
          "source_id": {
            "type": "string",
            "title": "Source Id"
          },
          "revision": {
            "type": "integer",
            "minimum": 1.0,
            "title": "Revision"
          },
          "slot": {
            "type": "string",
            "enum": [
              "preference",
              "goal",
              "experience"
            ],
            "title": "Slot"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "source_id",
          "revision",
          "slot"
        ],
        "title": "MemoryInput"
      },
      "SettingsInput": {
        "properties": {
          "name": {
            "type": "string",
            "maxLength": 20,
            "minLength": 1,
            "title": "Name",
            "default": "몽글이"
          },
          "profanity": {
            "type": "string",
            "enum": [
              "none",
              "mild"
            ],
            "title": "Profanity",
            "default": "mild"
          },
          "speech_level": {
            "type": "string",
            "enum": [
              "formal",
              "casual"
            ],
            "title": "Speech Level",
            "default": "casual"
          },
          "timezone": {
            "type": "string",
            "title": "Timezone",
            "default": "Asia/Seoul"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "title": "SettingsInput"
      },
      "SourceEdit": {
        "properties": {
          "expected_revision": {
            "type": "integer",
            "minimum": 1.0,
            "title": "Expected Revision"
          },
          "text": {
            "type": "string",
            "maxLength": 1500,
            "minLength": 1,
            "title": "Text"
          }
