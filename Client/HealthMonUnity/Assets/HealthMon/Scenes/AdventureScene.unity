  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: b9f1cee81dfa8e1448962bb2855596e4, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::AdventureDialogueManager
  eventDescription: {fileID: 1924488}
  dialogues:
  - type: 0
    lines:
    - "\uB3D9\uAD74\uC758 \uC785\uAD6C\uC5D0 \uB3C4\uCC29\uD588\uB2E4. \uD0D0\uD5D8\uC744
      \uC2DC\uC791\uD558\uC790!"
  - type: 1
    lines:
    - "\uB2E4\uC74C \uCE35\uC73C\uB85C \uC774\uB3D9 \uC911..."
    - "\uACC4\uB2E8\uC744 \uB530\uB77C \uC544\uB798\uCE35\uC73C\uB85C \uB0B4\uB824\uAC00\uACE0
      \uC788\uB2E4."
  - type: 2
    lines:
    - "\uC801\uC774 \uB098\uD0C0\uB0AC\uB2E4! \uC804\uD22C\uAC00 \uC2DC\uC791\uB41C\uB2E4!"
    - "\uC5B4\uB460 \uC18D\uC5D0\uC11C \uBAAC\uC2A4\uD130\uAC00 \uBAA8\uC2B5\uC744
      \uB4DC\uB7EC\uB0C8\uB2E4!"
  - type: 3
    lines:
    - "\uAC15\uB825\uD55C \uC801\uC758 \uAE30\uC6B4\uC774 \uB290\uAEF4\uC9C4\uB2E4.
      \uC815\uC608 \uC804\uD22C\uAC00 \uC2DC\uC791\uB41C\uB2E4!"
  - type: 4
    lines:
    - "\uBCF4\uBB3C\uC0C1\uC790\uB97C \uBC1C\uACAC\uD588\uB2E4. \uC5F4\uC5B4\uBCF4\uC790!"
    - "\uBC18\uC9DD\uC774\uB294 \uBCF4\uBB3C\uC774 \uB208\uC55E\uC5D0 \uB098\uD0C0\uB0AC\uB2E4!"
  - type: 5
    lines:
    - "\uC548\uC804\uD55C \uC7A5\uC18C\uB97C \uBC1C\uACAC\uD588\uB2E4. \uC7A0\uC2DC
      \uC26C\uC5B4\uAC00\uC790."
  - type: 6
    lines:
    - "\uC218\uC218\uAED8\uB07C\uAC00 \uC801\uD78C \uBE44\uC11D\uC744 \uBC1C\uACAC\uD588\uB2E4."
  - type: 7
    lines:
    - "\uC774\uC0C1\uD55C \uAE30\uC6B4\uC774 \uB290\uAEF4\uC9C4\uB2E4. \uBB34\uC2A8
      \uC77C\uC774 \uC77C\uC5B4\uB0A0\uAE4C?"
  - type: 8
    lines:
    - "\uC804\uD22C\uC5D0\uC11C \uC2B9\uB9AC\uD588\uB2E4! \uB2E4\uC74C \uCE35\uC73C\uB85C
      \uC9C4\uD589\uD560 \uC218 \uC788\uB2E4."
  - type: 9
    lines:
    - "\uC804\uD22C\uC5D0\uC11C \uD328\uBC30\uD588\uB2E4. \uD0D0\uD5D8\uC774 \uC885\uB8CC\uB418\uC5C8\uB2E4."
  - type: 10
    lines:
    - "\uC8FC\uBCC0\uC740 \uC870\uC6A9\uD558\uB2E4. \uB2E4\uC74C \uCE35\uC73C\uB85C
      \uC774\uB3D9\uD560 \uC218 \uC788\uB2E4."
