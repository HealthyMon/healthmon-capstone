  m_Script: {fileID: 11500000, guid: 06419d75b5f795543bcb9eef58dff0b1, type: 3}
  m_Name: AdventureSpecialDatabase
  m_EditorClassIdentifier: Assembly-CSharp::AdventureSpecialDatabase
  events:
  - title: "\uC218\uC0C1\uD55C \uC81C\uB2E8"
    description: "\uC5B4\uB450\uC6B4 \uB3D9\uAD74 \uC548\uC5D0 \uC624\uB798\uB41C
      \uC81C\uB2E8\uC774 \uC788\uB2E4. \uC190\uC744 \uBED7\uC5B4 \uBCFC\uAE4C?"
    choices:
    - text: "\uC81C\uB2E8\uC5D0 \uC190\uC744 \uC62C\uB9B0\uB2E4"
      outcomes:
      - weight: 50
        kind: 1
        stat: 0
        amount: -20
        itemId: 
        count: 1
        resultText: "\uCC28\uAC00\uC6B4 \uAE30\uC6B4\uC5D0 \uC0DD\uBA85\uB825\uC774
          \uBE60\uC838\uB098\uAC14\uB2E4."
      - weight: 35
        kind: 1
        stat: 4
        amount: 3
        itemId: 
        count: 1
        resultText: "\uC81C\uB2E8\uC5D0\uC11C \uD798\uC774 \uD758\uB7EC\uB4E4\uC5B4\uC654\uB2E4."
      - weight: 15
        kind: 0
        stat: 0
        amount: 0
        itemId: 
        count: 1
        resultText: "\uC81C\uB2E8\uC740 \uC544\uBB34 \uBC18\uC751\uC774 \uC5C6\uB2E4."
    - text: "\uC81C\uB2E8 \uC8FC\uBCC0\uC758 \uD2C8\uC744 \uC870\uC0AC\uD55C\uB2E4"
      outcomes:
      - weight: 50
        kind: 2
        stat: 0
        amount: 0
        itemId: potion_hp_01
        count: 1
        resultText: "\uD2C8\uC5D0\uC11C \uBB3C\uC57D\uC744 \uBC1C\uACAC\uD588\uB2E4."
      - weight: 50
        kind: 1
        stat: 2
        amount: -4
        itemId: 
        count: 1
        resultText: "\uD568\uC815\uC73C\uB85C \uAE30\uC6B4\uC744 \uBE7C\uC557\uACBC\uB2E4."
  - title: "\uAC08\uB77C\uC9C4 \uAD11\uB9E5"
    description: "\uBCBD\uC5D0\uC11C \uBE5B\uC774 \uC0C8\uC5B4 \uB098\uC628\uB2E4.
      \uBB34\uC5B8\uAC00\uB97C \uCE90\uB0BC \uC218 \uC788\uC744 \uAC83 \uAC19\uB2E4."
    choices:
    - text: "\uBE5B\uB098\uB294 \uBC14\uC704\uB97C \uCE90\uB0B8\uB2E4"
      outcomes:
      - weight: 40
        kind: 2
        stat: 0
        amount: 0
        itemId: potion_st_01
        count: 1
        resultText: "\uAD11\uC11D \uD2C8\uC5D0\uC11C \uC57D\uD488\uC744 \uBC1C\uACAC\uD588\uB2E4."
      - weight: 35
        kind: 1
        stat: 5
        amount: 2
        itemId: 
        count: 1
        resultText: "\uB2E8\uB2E8\uD55C \uAD11\uC11D\uC758 \uD798\uC744 \uD761\uC218\uD588\uB2E4."
      - weight: 25
        kind: 1
        stat: 0
        amount: -15
        itemId: 
        count: 1
        resultText: "\uBB34\uB108\uC9C4 \uB3CC\uC5D0 \uBD80\uC0C1\uC744 \uC785\uC5C8\uB2E4."
    - text: "\uD2C8\uC0C8 \uC548\uCABD\uC73C\uB85C \uC190\uC744 \uB123\uB294\uB2E4"
      outcomes:
      - weight: 50
        kind: 2
        stat: 0
        amount: 0
        itemId: potion_all_01
        count: 1
        resultText: "\uC228\uACA8\uC9C4 \uD68C\uBCF5\uC57D\uC744 \uCC3E\uC558\uB2E4."
      - weight: 50
        kind: 1
        stat: 2
        amount: -5
        itemId: 
        count: 1
        resultText: "\uB0A0\uCE74\uB85C\uC6B4 \uB3CC\uC744 \uD53C\uD558\uB290\uB77C
          \uC9C0\uCCE4\uB2E4."
  - title: "\uC758\uBB38\uC758 \uC0D8"
    description: "\uB9D1\uC544 \uBCF4\uC774\uC9C0\uB9CC \uC815\uCCB4\uB97C \uC54C
      \uC218 \uC5C6\uB294 \uBB3C\uC774 \uACE0\uC5EC \uC788\uB2E4."
    choices:
    - text: "\uC0D8\uBB3C\uC744 \uB9C8\uC2E0\uB2E4"
      outcomes:
      - weight: 50
        kind: 1
        stat: 0
        amount: 25
        itemId: 
        count: 1
        resultText: "\uC0DD\uBA85\uB825\uC774 \uD68C\uBCF5\uB418\uC5C8\uB2E4."
      - weight: 30
        kind: 1
        stat: 0
        amount: -18
        itemId: 
        count: 1
        resultText: "\uB3C5\uC131\uC774 \uC788\uB294 \uBB3C\uC774\uC5C8\uB2E4."
      - weight: 20
        kind: 1
        stat: 6
        amount: 2
        itemId: 
        count: 1
        resultText: "\uBAB8\uC5D0 \uC2E0\uBE44\uB85C\uC6B4 \uC800\uD56D\uB825\uC774
          \uAE43\uB4E4\uC5C8\uB2E4."
    - text: "\uC0D8\uBB3C\uB85C \uC190\uC744 \uC53B\uB294\uB2E4"
      outcomes:
      - weight: 60
        kind: 1
        stat: 2
        amount: 5
        itemId: 
        count: 1
        resultText: "\uD53C\uB85C\uAC00 \uC0AC\uB77C\uC84C\uB2E4."
      - weight: 40
        kind: 0
        stat: 0
        amount: 0
        itemId: 
        count: 1
        resultText: "\uC544\uBB34\uB7F0 \uBCC0\uD654\uAC00 \uC5C6\uB2E4."
